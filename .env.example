# Ghost Fabric local/production-foundation defaults
ENVIRONMENT=development
AUDIT_BACKEND=memory
DATABASE_URL=postgresql+psycopg://ghost:ghost@localhost:5432/ghost_fabric
RESTORE_ACTIVE_RUN=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
AUTH_MODE=optional
# Comma-separated token=role:subject. When set, Bearer auth is required.
# AUTH_TOKENS=viewer-token=viewer:DEMO-VIEWER,operator-token=operator:DEMO-OPERATOR
# Comma-separated API key=role:subject entries accepted via X-API-Key.
# AUTH_API_KEYS=viewer-key=viewer:API-VIEWER,operator-key=operator:API-OPERATOR
# HS256 secret for short-lived JWTs with required sub, role, and exp claims.
# Must be at least 32 bytes when set. Prefer a secret manager in production.
# AUTH_JWT_SECRET=replace-with-secret-manager-value-min-32-bytes
AUTH_JWT_ALGORITHM=HS256
RATE_LIMIT_PER_SECOND=1000
LOG_LEVEL=INFO
LOG_JSON=true
DEFAULT_ACTOR=DEMO-OPERATOR
DEFAULT_ROLE=operator
# Production posture (ENVIRONMENT=production) requires:
# AUTH_MODE=required, DEFAULT_ROLE=viewer, and at least one of AUTH_TOKENS / AUTH_API_KEYS / AUTH_JWT_SECRET.
# Never commit real credentials. Compose demo tokens are local-only fixtures.
VITE_API_TOKEN=
